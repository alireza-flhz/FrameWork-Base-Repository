<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>BaseRepository</RootNamespace>
    <AssemblyName>BaseRepository</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BaseRepository</PackageId>
    <Version>1.0.0</Version>
    <Description>A generic EF Core repository base class (CRUD, pagination, eager-loading includes) with a consistent OperationResult wrapper, meant to be dropped into a new project's data access layer.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/alireza-flhz/FrameWork-Base-Repository</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
  </ItemGroup>

</Project>
